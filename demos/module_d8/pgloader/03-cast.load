-- Clip D8.3, third attempt: casting rules that keep lengths and precisions, timestamps
-- without time zone, and the index names of SQL Server.
LOAD DATABASE
  FROM mssql://{{MSSQL_USER}}:{{MSSQL_PASSWORD}}@{{MSSQL_HOST}}:{{MSSQL_PORT}}/{{MSSQL_DB}}
  INTO postgresql://postgres:course@pgd8-schema/pachadata
  WITH schema only, preserve index names
  INCLUDING ONLY TABLE NAMES LIKE '%' IN SCHEMA 'Stage'
  INCLUDING ONLY TABLE NAMES LIKE '%' IN SCHEMA 'Inscription'
  INCLUDING ONLY TABLE NAMES LIKE '%' IN SCHEMA 'Formateur'
  INCLUDING ONLY TABLE NAMES LIKE 'Adresse', 'Contact', 'Employe', 'Societe', 'SocieteAdresse', 'TypeAdresse' IN SCHEMA 'Contact'
  INCLUDING ONLY TABLE NAMES LIKE 'Devise%', 'JourFerie', 'LieuFormation', 'ModePaiement', 'Pays', 'SalleFormation', 'TauxTVA' IN SCHEMA 'Reference'
  CAST type varchar to varchar keep typemod,
       type nvarchar to varchar keep typemod,
       type char to char keep typemod,
       type nchar to char keep typemod,
       type decimal to numeric keep typemod,
       type datetime to timestamp,
       type datetime2 to timestamp,
       type smalldatetime to timestamp
  BEFORE LOAD DO
  $$ create function public.suser_sname() returns text language sql as 'select current_user::text' $$;
